# Share / clean package — no Google auth included
PORT=8020
HOST=127.0.0.1

API_KEYS=pg123456

WEB_CONSOLE_USERNAME=
WEB_CONSOLE_PASSWORD=
SECURE_COOKIES=false
SESSION_COOKIE_NAME=pg.sid

TZ=Asia/Shanghai
LOG_LEVEL=INFO

# Change to YOUR local proxy. Leave empty if not needed.
HTTP_PROXY=http://127.0.0.1:12000
HTTPS_PROXY=http://127.0.0.1:12000
NO_PROXY=localhost,127.0.0.1

MAX_CONTEXTS=1
STREAMING_MODE=real
MAX_RETRIES=2
RETRY_DELAY=3000
SWITCH_ON_USES=0
FAILURE_THRESHOLD=3
IMMEDIATE_SWITCH_STATUS_CODES=429,503
SAFETY_SETTINGS_THRESHOLD=OFF
ENABLE_AUTH_UPDATE=true
ENABLE_USAGE_STATS=true
CHECK_UPDATE=false

USE_PLAYGROUND_PANEL=true
PLAYGROUND_BOOTSTRAP_MODEL=gemini-flash-latest
TEMPORARY_CHAT=true
# No auth files shipped; add one with Add-Account.bat first
INITIAL_AUTH_INDEX=0
